    "space-12": { "$value": "48px" },
    "space-14": { "$value": "56px" },
    "space-16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "radius-xs": {
      "$value": "6px",
      "$description": "Tiny badges and tooltips."
    },
    "radius-sm": {
      "$value": "8px",
      "$description": "Icon buttons and small controls."
    },
    "radius-md": {
      "$value": "10px",
      "$description": "Buttons, fields and menu items."
    },
    "radius-lg": {
      "$value": "14px",
      "$description": "Inner cards and floating bars."
    },
    "radius-xl": {
      "$value": "16px",
      "$description": "Cards and dialogs."
    },
    "radius-2xl": {
      "$value": "22px",
      "$description": "A large card standing alone on a page."
    },
    "radius-pill": { "$value": "999px" }
  },
  "shadow": {
    "shadow-card": {
      "$value": "0 1px 2px rgba(20, 40, 90, .04)"
    },
    "shadow-float": {
      "$value": "0 10px 30px -12px rgba(20, 40, 90, .25)",
      "$description": "Floating bars, popovers, menus, dialogs."
    },
    "shadow-raised": {
      "$value": "0 1px 2px rgba(20, 40, 90, .04), 0 18px 50px -24px rgba(30, 60, 130, .18)",
      "$description": "A card standing alone on a page."
    }
  },
  "motion": {
    "dur-press": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "Buttons scale to .96 while pressed."
    },
    "dur-ui": {
      "$type": "duration",
      "$value": "180ms",
      "$description": "Hovers and popovers."
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [0.22, 1, 0.36, 1]
    },
    "dur-long": {
      "$type": "duration",
      "$value": "1600ms",
      "$description": "A change of scene: the brand light withdrawing, a page giving way to the next."
    },
    "ease-in-out": {
      "$type": "cubicBezier",
      "$value": [0.65, 0, 0.35, 1],
      "$description": "Something that starts and ends at rest, as the brand light withdrawing."
    }
