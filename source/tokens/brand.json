  "gradient": {
    "glow": {
      "$value": "radial-gradient(150% 48% at 50% 112%, rgba(168, 201, 240, .42) 0%, rgba(63, 127, 212, .30) 30%, rgba(10, 36, 88, 0) 64%), linear-gradient(180deg, {color.navy-900} 0%, {color.navy-800} 100%)",
      "$description": "The brand light rising from below a navy surface. The same in both appearances."
    }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Each stack names only the decided face, and its fallback face where it has one, then the generic family.",
    "font-prose": {
      "$value": ["New Computer Modern", "serif"],
      "$description": "Running text in documents: New Computer Modern, Book cut."
    },
    "font-math": {
      "$value": ["New Computer Modern Math", "math"],
      "$description": "Formulas, typeset by the browser from MathML."
    },
    "font-ui": {
      "$value": ["Instrument Sans", "Libertinus Sans", "sans-serif"],
      "$description": "The interface, document headings and the wordmark. Libertinus Sans supplies the Greek and symbols Instrument Sans lacks."
    },
    "font-mono": {
      "$value": ["JuliaMono", "monospace"],
      "$description": "Code and identifiers."
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "The type scale. A role or a document element takes one of these steps.",
