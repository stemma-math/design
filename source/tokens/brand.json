    "step-7": { "$value": "27px" },
    "step-8": { "$value": "34px" }
  },
  "text": {
    "$description": "Text roles, as `font` shorthands.",
    "text-display": {
      "$value": "600 {size.step-8}/1.1 {font.font-ui}",
      "$description": "The largest title on a page, with letter-spacing -0.02em."
    },
    "text-title": {
      "$value": "600 {size.step-6}/1.2 {font.font-ui}",
      "$description": "A page's or a dialog's title."
    },
    "text-heading": {
      "$value": "600 {size.step-5}/1.3 {font.font-ui}",
      "$description": "A section heading in an interface, with letter-spacing -0.01em."
    },
    "text-body": {
      "$value": "400 {size.step-4}/1.5 {font.font-ui}"
    },
    "text-meta": {
      "$value": "400 14px/1.45 {font.font-ui}",
      "$description": "Secondary text: dates, counts, descriptions."
    },
    "text-small": {
      "$value": "500 {size.step-2}/1.4 {font.font-ui}"
    },
    "text-label": {
      "$value": "500 {size.step-1}/1.3 {font.font-ui}",
      "$description": "Chips, table headers, section labels. Sentence case, never uppercase."
    },
    "text-mono-sm": {
      "$value": "400 {size.step-1}/1.4 {font.font-mono}"
    },
    "text-prose": {
      "$value": "400 {size.step-5}/1.55 {font.font-prose}",
      "$description": "Running text in documents."
    }
  },
  "measure": {
